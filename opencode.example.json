{
  "$schema": "https://opencode.ai/config.json",
  "model": "your-provider/your-model",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.12.0", "--isolated"],
      "enabled": true
    }
  },
  "provider": {
    "your-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Your Provider",
      "options": {
        "baseURL": "https://your-provider.example/api/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "your-model": { "name": "Your Model" }
      }
    }
  }
}
